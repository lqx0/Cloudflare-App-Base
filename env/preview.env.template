# ====================================================================
# .env.preview template
# ====================================================================
ENVIRONMENT=preview

# aDaptQuiz Preview uses Resend. This non-secret value must match wrangler.toml.
EMAIL_PROVIDER=resend

# Generic email provider API key. Required for EMAIL_PROVIDER=resend.
EMAIL_API_KEY=
RECRUIT_QUIZ_RECIPIENT_EMAIL=

# Do not guess the workers.dev URL. After the adaptquiz-preview Worker exists,
# replace this marker and the matching APP_BASE_URL marker in wrangler.toml with
# the real URL reported by Cloudflare.
APP_BASE_URL=REPLACE_WITH_ADAPTQUIZ_PREVIEW_WORKERS_DEV_URL

# Shared secret for the management CLI (`npm run auth ...`). Must match the
# CLI_API_KEY deployed to the preview worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CLI_API_KEY=

# CLI API URL override (optional)
CLI_API_URL_PREVIEW=REPLACE_WITH_ADAPTQUIZ_PREVIEW_WORKERS_DEV_URL
